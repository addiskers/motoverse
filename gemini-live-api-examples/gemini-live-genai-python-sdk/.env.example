GEMINI_API_KEY=
MODEL=gemini-3.1-flash-live-preview

# ---- Twilio (phone calls) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+19785715824
PUBLIC_URL=

# ---- Admin dashboard (INTERNAL — shows cost/margin) ----
# Key required to open /admin and call /api/admin/* (X-Admin-Key header / ?key=)
ANALYTICS_SECRET=autoverse2026

# ---- Client analytics API (EXTERNAL — cost-free) ----
# Separate key for /analytics dashboard and /api/v1/analytics/* (Bearer token).
# Safe to share with the client's developers: exposes only usage & booking data,
# never cost/margin. No default — if blank the client API returns 503.
# Generate a long random value, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ANALYTICS_API_KEY=

# ---- Call recordings ----
# Save every call (both sides, mixed) as a mono 16 kHz WAV under DATA_DIR/recordings.
# About 1.9 MB per minute (~13 MB per 7-minute call). Served via
# /api/v1/analytics/calls/{id}/recording (client key) and /api/admin/... (admin key).
RECORD_CALLS=true
# Auto-delete recordings older than this many days (0 = keep forever).
# Disk math: 100 calls/day x 13 MB x 30 days = ~39 GB. Lower this if the VM is small.
RECORDING_RETENTION_DAYS=30
# recording_url in API responses is a signed link that plays without the API key.
# How long each link stays valid (seconds; default 24 h). The signing secret defaults
# to a hash of ANALYTICS_API_KEY; set RECORDING_URL_SECRET to decouple the two.
RECORDING_URL_TTL_SECONDS=86400
# RECORDING_URL_SECRET=

# ---- AutoServe booking system (real bookings) ----
# OFF BY DEFAULT. While this is false the agent uses the built-in demo data and
# behaves exactly as it always has. Set to true ONLY when you want the voice
# agent to make REAL bookings in the dealership's live system.
AUTOSERVE_ENABLED=false
AUTOSERVE_BASE_URL=https://autoverseai-autoserve.vercel.app/api/v1
AUTOSERVE_API_KEY=
# Customer looked up when the demo link carries no ?mobile= parameter.
AUTOSERVE_DEFAULT_MOBILE=
AUTOSERVE_TIMEOUT_SECONDS=6

# ---- Outbound calls dispatched by AutoServe (POST /call-me, via Plivo) ----
# /call-me is CLOSED unless one of these is set; it never runs unauthenticated.
# Shared secret AutoServe signs requests with (X-AutoServe-Signature, HMAC-SHA256
# over "<timestamp>.<body>"). Provided by AutoServe.
AUTOSERVE_WEBHOOK_SECRET=
# Optional: lets us trigger /call-me ourselves for testing, via X-API-Key.
CALL_ME_API_KEY=
# Plivo account (Console -> API keys) and the Plivo number calls are made from.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_NUMBER=
# (PLIVO_FROM_NUMBER is accepted as an alias for PLIVO_NUMBER.)
# Hard call length limit; the agent is told to wind up 25 s before it.
CALL_TIME_LIMIT_SECONDS=420
PLIVO_RING_TIMEOUT_SECONDS=45
# Optional: secret for the per-call URLs given to Plivo (defaults to a hash of
# PLIVO_AUTH_TOKEN).
# OUTBOUND_URL_SECRET=

# ---- Call log + cost storage ----
# JSON call records are written to DATA_DIR/calls/<id>.json.
# NOTE: Render wipes the local filesystem on every deploy. For durable history,
# attach a Render Persistent Disk and set DATA_DIR to a path on it, e.g. /var/data
DATA_DIR=

# ---- Gemini cost rates (USD per 1,000,000 tokens, paid tier) ----
RATE_GEMINI_TEXT_IN=0.75
RATE_GEMINI_AUDIO_IN=3.00
RATE_GEMINI_IMGVID_IN=1.00
RATE_GEMINI_TEXT_OUT=4.50
RATE_GEMINI_AUDIO_OUT=12.00

# ---- Twilio fallback rate (USD per minute) ----
# Only used until Twilio's real billed Call.price is fetched.
RATE_TWILIO_PER_MIN=0.014